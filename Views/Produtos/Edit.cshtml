@model TechStoreMVC.Models.Produto

@{
    ViewData["Title"] = "Editar produto";
}

<h1>Editar produto</h1>

<hr />

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* Mantém o Id oculto para enviar no corpo da requisição *@
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Preco" class="form-label"></label>
        <input asp-for="Preco" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Preco" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Estoque" class="form-label"></label>
        <input asp-for="Estoque" class="form-control" type="number" />
        <span asp-validation-for="Estoque" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-warning">
            Salvar alterações
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}